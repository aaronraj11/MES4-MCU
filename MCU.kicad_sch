	)
	(text "Totals: 14 carrier GPIOs (PA0–PA7 also ADC IN0–IN7) + I2C1 + VCP UART + SWD + NRST on the M.2 (USB wired, unused);  on-module: CAN, 2 LEDs, buzzer, 5 V sense, HSE.\nInternal ADC channels (no pin needed): VREFINT → measures the real 3V3 rail, temperature sensor.  [PA9] / [PA10] = SYSCFG remap option, leave off."
		(exclude_from_sim no)
		(at 24.13 250.19 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c50dbb17-38dd-45dc-9f85-1cde89cb2234")
	)
